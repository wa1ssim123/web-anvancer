# HORENOVA — prevent secrets, private data and generated files from being committed.
# Existing tracked files are unaffected; keep secrets only in Wix / Render / Neon.
.env
.env.*
!.env.example
!.env.sample
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
*.pem
*.p12
*.pfx
*.key
*.keystore
*.jks
id_rsa*
id_ed25519*
**/credentials.json
**/service-account.json
**/service_account.json
**/secrets.json
**/secrets.*
!**/secrets.example.json
node_modules/
**/node_modules/
.DS_Store
Thumbs.db
*.log
logs/
.cache/
coverage/
playwright-report/
test-results/
*.sqlite
*.sqlite3
*.db
*.bak
*.backup
*.dump
*.sql.gz
*.zip
*.tar.gz
